# deploy/.env — docker-compose가 읽는 배포 설정. `cp .env.example .env` 후 채우세요.
# 이 파일(.example)에는 실제 시크릿을 넣지 마세요. .env는 커밋하지 마세요(.gitignore).

# 서비스할 도메인. DNS A레코드가 이 VPS를 가리켜야 Caddy가 TLS를 발급합니다.
DOMAIN=api.example.com

# PostGIS 접속. POSTGRES_PASSWORD는 반드시 강한 값으로 교체하세요.
POSTGRES_USER=b2d
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=b2d_geo

# 토지 실거래(/v1/appraisal/sales) 조회용 공공데이터 키(data.go.kr). 비우면 실거래만 비활성.
MOLIT_API_KEY=

# 웹 데모/문서의 try-it-out이 사용할 데모 키. 배포 후 아래로 발급해 채우세요:
#   docker compose run --rm --entrypoint /b2d-etl app apikey create --name demo --scopes geo,realestate --rate 5
B2D_DEMO_API_KEY=

# true면 /issue-demo-key(개발자 셀프 발급) 노출. 공개 미리보기에서만 켜세요.
B2D_SELF_SERVE_DEMO=false

# V-World(국토교통부 공간정보 오픈플랫폼) 키. 지도 화면의 항공사진 토글에 쓰입니다.
# 타일 URL에 들어가 브라우저에 노출되므로 V-World 관리 화면에서 서비스 URL(도메인)을
# 이 사이트 도메인으로 제한하세요. 비우면 항공사진 토글이 숨겨집니다.
B2D_VWORLD_KEY=
# 브이월드에 등록한 서비스 URL. ned-sync(국가중점데이터 API 자동 적재)가 domain 파라미터로 보낸다.
# 도메인을 옮기면 브이월드 키 설정과 함께 바꾼다. 비면 https://api.birth2death.com
B2D_VWORLD_DOMAIN=

# 한국부동산원 R-ONE Open API 인증키. rone-sync(지가변동률 자동 적재)만 쓴다(서버 안에서만, 브라우저 노출 없음).
RONE_API_KEY=

# 기본은 직접 등록 DB입니다. 네이버는 별도 서비스에서 source=naver로 명시합니다.
B2C_LISTING_SOURCE=direct
# 공급원별 별도 market 유닛에 실제 접속 정보를 설정합니다. docs/market-feed-v1.md 참고.
B2C_MARKET_SOURCE_ID=
B2C_MARKET_SOURCE_NAME=
B2C_MARKET_SCOPE=
B2C_MARKET_COMPLEX_NAME=
B2C_MARKET_URL=
B2C_MARKET_TOKEN=
# 네이버 서비스가 조회할 단지 번호.
# 네이티브 systemd 서비스는 .env를 자동으로 읽지 않습니다. 아래 B2C 설정은 OPS.md 6-4의
# drop-in Environment로 전달하세요. 운영 .env 전체를 서비스에 연결할 필요는 없습니다.
B2C_COMPLEX_NO=
# HTTP 요청 1회 제한(Go duration). 기본 40s이며 전체 실행 제한은 165s입니다.
B2C_HTTP_TIMEOUT=40s
# 요청 실패 시 재시도 횟수. 기본 3, 0이면 재시도하지 않습니다.
B2C_HTTP_RETRIES=3
# 모바일 API fallback 사용 여부(선택). 기본 true, 끄려면 false.
B2C_MOBILE_FALLBACK=true

# 실제 Caddy 프록시의 IP/CIDR만 허용. 비우면 전달 헤더를 신뢰하지 않습니다.
# 값은 네트워크를 확인한 후 설정하세요. 0.0.0.0/0, ::/0 사용 금지.
# 자세한 검증/Cloudflare 연결 조건은 RUNTIME_CACHE_RATE_LIMIT.md 참고.
B2D_TRUSTED_PROXY_CIDRS=

# 기존 인증 결과 캐시: 키 폐기 반영이 최대 이 시간만큼 지연됩니다.
B2D_AUTH_CACHE_TTL=30s

# Sentry 에러 추적 (선택). DSN은 sentry.io 프로젝트(Platform: Go)에서 발급.
# 비우면 Sentry 없이 기존 로그(X-Request-Id)만 사용합니다.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
