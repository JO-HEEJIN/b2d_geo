# Caddy 리버스 프록시 — {$DOMAIN}에 대해 Let's Encrypt TLS를 자동 발급/갱신한다.
# 앱은 같은 compose 네트워크의 app:8080. HTTP는 HTTPS로 자동 리다이렉트.

{$DOMAIN} {
	encode gzip zstd

	# 원격 MCP(streamable HTTP) — mcp 컨테이너로 프록시. handle은 상호 배타라
	# /mcp 계열만 여기로 가고 나머지는 아래 기본 블록이 받는다.
	# log_skip: /mcp/{key} 형태(키 내장 URL)의 키가 접근 로그에 남지 않게
	# MCP 트래픽은 로그를 남기지 않는다.
	@mcp path /mcp /mcp/*
	handle @mcp {
		log_skip
		reverse_proxy mcp:8330
	}

	handle {
		reverse_proxy app:8080

		# 정적 자산 캐시(해시 없는 파일이라 보수적으로). API 응답은 앱이 제어.
		@static path /vendor/* /styles.css /*.js
		header @static Cache-Control "public, max-age=3600"
	}

	# 접근 로그(IP 포함)는 파일로 남기고 90일(2160h) 후 자동 파기한다.
	# 개인정보처리방침(privacy.html)의 "접근 로그 90일 보관" 문구와 이 설정이
	# 실체 일치 쌍이다 — 한쪽을 바꾸면 반드시 다른 쪽도 바꿀 것.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 20
			roll_keep_for 2160h
		}
		format console
	}
}
