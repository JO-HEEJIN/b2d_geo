+  .has-report .results { grid-template-columns: 1fr; border-left: 0; }
+  .col { overflow: visible; border-right: 0; border-bottom: 1px solid var(--border); }
+  .col-title { position: static; }
+  .print-box { position: static; margin: 8px 0 0; }
+  /* 한 열로 쌓이면 판단 요약을 맨 위로 (가장 먼저 읽을 내용). */
+  .col-summary { order: -1; }
+}
+@media (max-width: 780px) {
+  .map-app { grid-template-areas: "geo" "panel"; }
+  .has-report .map-panel { flex-direction: column; align-items: stretch; }
+  .map-app.has-report { grid-template-rows: auto 60vh auto; }
+}
+
+/* ---- 리포트 출력 (A4) ---- */
+/* 출력 버튼이나 브라우저 인쇄 직전에 print-mode를 켜서, 지도가 인쇄 크기로 타일을
+   다시 받게 한다. 인쇄 순서: 제목 -> 사진·지도 -> 판단 요약 -> 지가변동률 -> 거래내역.
+   (길이가 긴 거래 목록을 맨 뒤로 보내 차트가 쪽 경계에서 잘리지 않게 한다.) */
+body.print-mode .topbar, body.print-mode .map-panel, body.print-mode .landing-foot,
+body.print-mode .no-print, body.print-mode .leaflet-control-zoom { display: none !important; }
+/* 화면에서도 A4 본문 폭(210mm - 여백 24mm)으로 줄여 두어야 지도가 인쇄 크기에 맞춰 다시 그려진다. */
+body.print-mode .map-app { display: block; height: auto; max-width: 186mm; margin: 0 auto; }
+body.print-mode .print-head { display: block; margin: 0 0 10px; }
+body.print-mode .col-geo { flex-direction: row; gap: 10px; height: 270px; margin-bottom: 12px; }
+body.print-mode .photo-box { display: flex; height: 100%; flex: 1 1 0; min-width: 0; border: 1px solid var(--border); }
+body.print-mode .photo-box .col-title { display: none; }
+body.print-mode .col-geo #map { height: 100%; flex: 1 1 0; min-width: 0; border: 1px solid var(--border); }
+body.print-mode .results { display: flex; flex-direction: column; border: 0; }
+body.print-mode .col { overflow: visible; border: 0; padding: 0; }
+body.print-mode .col-summary { order: 1; }
+body.print-mode .col-index { order: 2; }
+body.print-mode .col-sales { order: 3; }
+body.print-mode .col-title { position: static; font-size: 14px; padding: 12px 0 6px; }
+body.print-mode .sale, body.print-mode .tile, body.print-mode .card { break-inside: avoid; }
+/* 인쇄에서는 차트를 적당한 크기로, 월별 값 표는 3단으로 접어 쪽수를 줄인다. */
+body.print-mode #ziOut { max-width: 120mm; break-inside: avoid; }
+body.print-mode .range-label, body.print-mode .col-title, body.print-mode .month-head { break-after: avoid; }
+body.print-mode .sale { padding: 4px 2px; }
+body.print-mode table.zi-table, body.print-mode table.zi-table tbody { display: block; }
+body.print-mode table.zi-table thead { display: none; }
+body.print-mode table.zi-table tbody { columns: 3; column-gap: 18px; }
+body.print-mode table.zi-table tr { display: flex; justify-content: space-between; break-inside: avoid; border-bottom: 1px solid var(--border); }
+body.print-mode table.zi-table td { border: 0; padding: 2px 4px; }
+.print-head .ph-title { font-size: 20px; font-weight: 800; letter-spacing: -.02em; }
+.print-head .ph-meta { font-size: 12.5px; color: var(--ink-2); margin-top: 2px; }
+
+@media print {
+  @page { size: A4; margin: 12mm; }
+  /* 다크 테마로 보던 중이어도 종이에는 라이트 토큰으로 출력한다. */
+  :root:root {
+    color-scheme: light;
+    --bg: #fff; --surface: #fff; --surface-2: #f1f4f2; --surface-3: #e4eae7;
+    --ink: #14201c; --ink-2: #48534e; --ink-3: #6b746f; --border: #d6ddd9;
+    --border-strong: #c4cec9; --accent: #0f766e; --accent-2: #0b5c55;
+    --accent-soft: #e3f2ef; --gold: #a45a09; --gold-soft: #f8eedf;
+    --good: #15803d; --warn: #b45309; --neutral: #64748b;
+  }
+  body { background: #fff; }
+}
