@@ -0,0 +1,108 @@
+package rone
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestParseRegion(t *testing.T) {
+	// 지역 이름은 운영 서버 프로브 출력(2026-10-28)에 나온 값 그대로다.
+	cases := map[string]place{
+		"부산>중구":       {Name: "부산광역시 중구"},
+		"경기>화성시":      {Name: "경기도 화성시"},
+		"경기>화성시>만세구":  {Name: "경기도 화성시 만세구"},
+		"세종":          {Code: "36110"},
+		"인천>(구)동구":    {Name: "인천광역시 동구", Legacy: true},
+		"전남광주>광주>광산구": {Name: "광주광역시 광산구"},
+		"전남광주>광주":     {Aggregate: true},
+		"전남광주>순천시":    {Name: "전라남도 순천시"},
+		"서울":          {Aggregate: true},
+		"전국":          {Aggregate: true},
+		"":            {Aggregate: true},
+		"경기>시지역":      {Aggregate: true},
+		"강원>군지역":      {Aggregate: true},
+		"없는도>어딘가":     {},
+		" 대구 > 군위군 ":  {Name: "대구광역시 군위군"},
+		"강원>춘천시":      {Name: "강원특별자치도 춘천시"},
+	}
+	for in, want := range cases {
+		if got := parseRegion(in); !reflect.DeepEqual(got, want) {
+			t.Errorf("parseRegion(%q) = %+v, want %+v", in, got, want)
+		}
+	}
+}
+
+func TestBuild(t *testing.T) {
+	xw := map[string]string{
+		"부산광역시 중구":    "26110",
+		"경기도 수원시 장안구": "41111",
+		"경기도 화성시":     "41590", // 주소 DB가 구 신설 전이면 시 단위만 있다
+		"인천광역시 서구":    "28260",
+		"인천광역시 동구":    "28140",
+		"광주광역시 광산구":   "29200",
+		"전라남도 순천시":    "46150",
+		// "경기도 수원시"는 구가 여럿이라 크로스워크에서 빠져 있다
+	}
+	r := func(grp, zone string, v float64) Row { return Row{Region: grp, Zone: zone, Month: "202606", Rate: v} }
+	rows := []Row{
+		r("부산>중구", "주거지역", 0.016),
+		r("인천>(구)서구", "주거지역", 9), // 같은 코드에 현재 이름 행이 뒤에 온다 -> 버림
+		r("인천>서구", "주거지역", 0.2),
+		r("인천>(구)동구", "주거지역", 0.3), // 현재 이름 행이 없다 -> 그대로 씀
+		r("경기>수원시", "주거지역", 5),     // 하위 구가 있는 시 집계 -> 집계로 셈
+		r("경기>수원시>장안구", "주거지역", 0.4),
+		r("경기>화성시", "주거지역", 0.5),
+		r("경기>화성시>만세구", "주거지역", 7), // 주소 DB에 없는 신설 구 -> 미매핑
+		r("세종", "주거지역", 0.6),
+		r("전남광주>광주>광산구", "녹지지역", 0.7),
+		r("전남광주>순천시", "관리(통합)지역", 0.8),
+		r("서울", "주거지역", 1),
+		r("부산>중구", "주거지역", 99), // 같은 키 두 번째 -> 첫 행만
+	}
+	st := &Stats{}
+	unknown := map[string]bool{}
+	got := build(rows, xw, st, unknown)
+	want := []rec{
+		{"26110", "주거지역", "202606", 0.016, false},
+		{"28260", "주거지역", "202606", 0.2, false},
+		{"28140", "주거지역", "202606", 0.3, true},
+		{"41111", "주거지역", "202606", 0.4, false},
+		{"41590", "주거지역", "202606", 0.5, false},
+		{"36110", "주거지역", "202606", 0.6, false},
+		{"29200", "녹지지역", "202606", 0.7, false},
+		{"46150", "관리(통합)지역", "202606", 0.8, false},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("build:\n got %+v\nwant %+v", got, want)
+	}
+	if st.Aggregate != 2 || st.Unmapped != 1 || st.Superseded != 1 || st.Dup != 1 {
+		t.Fatalf("stats %+v", st)
+	}
+	if !unknown["경기>화성시>만세구"] || len(unknown) != 1 {
+		t.Fatalf("unknown %v", unknown)
+	}
+}
+
+func TestPickAndMonthRange(t *testing.T) {
+	ms, err := monthRange("202511", "202602")
+	if err != nil || !reflect.DeepEqual(ms, []string{"202511", "202512", "202601", "202602"}) {
+		t.Fatalf("monthRange %v %v", ms, err)
+	}
+	for _, bad := range [][2]string{{"202602", "202511"}, {"2025", "202602"}, {"202513", "202602"}} {
+		if _, err := monthRange(bad[0], bad[1]); err == nil {
+			t.Errorf("%v should fail", bad)
+		}
+	}
+	all := []string{"202601", "202602", "202603", "202604", "202605", "202606"}
+	// 받은 달 202601~202604, 마지막 2개월은 다시 -> 202603~202606
+	got := pick(all, []string{"202601", "202602", "202603", "202604"}, 2)
+	if !reflect.DeepEqual(got, []string{"202603", "202604", "202605", "202606"}) {
+		t.Fatalf("pick %v", got)
+	}
+	if got := pick(all, nil, 3); !reflect.DeepEqual(got, all) {
+		t.Fatalf("pick first run %v", got)
+	}
+	if got := pick(all, all, 0); got != nil {
+		t.Fatalf("pick all loaded, refetch 0: %v", got)
+	}
+}
diff --git a/internal/etl/rone/rone.go b/internal/etl/rone/rone.go
new file mode 100644
index 0000000..842fa50
--- /dev/null
+++ b/internal/etl/rone/rone.go
@@ -0,0 +1,227 @@
+// Package rone은 한국부동산원 R-ONE Open API에서 "(월) 용도지역별 지가변동률"(A_2024_00007)을 받아
+// land_price_index에 적재한다. 손으로 받던 포털 JSON(10개월)을 대신해 2005년부터 백필하고, 이후 새 달만 받는다.
+//
+// 응답 구조(2026-10-28 운영 서버에서 확인): GRP_FULLNM = 지역 경로("부산>중구", "경기>화성시>만세구", "세종",
+// "전남광주>광주>광산구"), CLS_FULLNM = 용도지역("주거지역" 등 10종), DTA_VAL = 변동률(%).
+// 원칙: 원값 그대로 적재(재분류·보정 없음). 집계 행(전국·시도·시지역·군지역)은 건너뛴다.
+package rone
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const (
+	// StatblID는 "(월) 용도지역별 지가변동률" 통계표다.
+	StatblID = "A_2024_00007"
+	baseURL  = "https://www.reb.or.kr/r-one/openapi/SttsApiTblData.do"
+	pageSize = 1000
+	maxPages = 50
+)
+
+// Row는 API 한 행이다.
+type Row struct {
+	Region string  // GRP_FULLNM, 없으면 ""(전국 집계)
+	Zone   string  // CLS_FULLNM
+	Month  string  // YYYYMM
+	Rate   float64 // DTA_VAL
+}
+
+// Client는 API 호출기다. Key는 오류 메시지에 남기지 않는다.
+type Client struct {
+	Key       string
+	HTTP      *http.Client
+	Base      string        // 테스트에서 바꾼다
+	Pause     time.Duration // 호출 사이 간격
+	RetryWait time.Duration // 0이면 2초
+	Calls     int
+}
+
+// APIError는 재시도하지 않는 오류(키·권한 등)다.
+type APIError struct{ Msg string }
+
+func (e *APIError) Error() string { return "r-one api: " + e.Msg }
+
+type apiResp struct {
+	Data []struct {
+		Head []json.RawMessage `json:"head"`
+		Row  []struct {
+			Grp   *string  `json:"GRP_FULLNM"`
+			Cls   *string  `json:"CLS_FULLNM"`
+			Month string   `json:"WRTTIME_IDTFR_ID"`
+			Val   *float64 `json:"DTA_VAL"`
+		} `json:"row"`
+	} `json:"SttsApiTblData"`
+	Result *struct {
+		Code    string `json:"CODE"`
+		Message string `json:"MESSAGE"`
+	} `json:"RESULT"`
+}
+
+// isNoData는 아직 공표되지 않은 달 등 "해당하는 데이터가 없습니다" 응답인지 본다.
+// 운영 서버 프로브에서 문구는 확인했고 코드(INFO-200)는 공공 OpenAPI 관례라 둘 다 받는다.
+func isNoData(code, msg string) bool {
+	return code == "INFO-200" || strings.Contains(msg, "해당하는 데이터가 없습니다")
+}
+
+// FetchMonth는 한 달치를 모두 받는다. 아직 공표 전이면 (nil, false, nil).
+func (c *Client) FetchMonth(ctx context.Context, month string) ([]Row, bool, error) {
+	var out []Row
+	total, got := -1, 0
+	for p := 1; p <= maxPages; p++ {
+		r, err := c.getPage(ctx, month, p)
+		if err != nil {
+			return nil, false, err
+		}
+		code, msg, t := pageMeta(r)
+		if isNoData(code, msg) {
+			if p == 1 {
+				return nil, false, nil
+			}
+			return out, true, nil // 마지막 페이지를 넘겼다
+		}
+		if code != "INFO-000" {
+			// 정상 응답은 항상 INFO-000을 싣는다. 코드가 없거나 다르면(키 오류 등) 멈춘다.
+			return nil, false, &APIError{Msg: fmt.Sprintf("%q %s: %s", code, month, c.redact(msg))}
+		}
+		if total < 0 {
+			total = t
+		}
+		n := 0
+		for _, d := range r.Data {
+			for _, row := range d.Row {
+				n++
+				if row.Val == nil || row.Cls == nil {
+					continue
+				}
+				reg := ""
+				if row.Grp != nil {
+					reg = *row.Grp
+				}
+				out = append(out, Row{Region: reg, Zone: strings.TrimSpace(*row.Cls), Month: row.Month, Rate: *row.Val})
+			}
+		}
+		got += n // 값이 빈 행도 센다. 건수는 원 행 기준이다
+		if n == 0 || got >= total {
+			return out, true, nil
+		}
+	}
+	return nil, false, &APIError{Msg: fmt.Sprintf("%s: more than %d pages", month, maxPages)}
+}
+
+// pageMeta는 결과 코드와 전체 건수를 꺼낸다. 정상 응답은 head 안에, 오류 응답은 최상위 RESULT에 코드가 온다.
+func pageMeta(r *apiResp) (code, msg string, total int) {
+	if r.Result != nil {
+		return r.Result.Code, r.Result.Message, 0
+	}
+	for _, d := range r.Data {
+		for _, h := range d.Head {
+			var m map[string]json.RawMessage
+			if json.Unmarshal(h, &m) != nil {
+				continue
+			}
+			if v, ok := m["list_total_count"]; ok {
+				_ = json.Unmarshal(v, &total)
+			}
+			if v, ok := m["RESULT"]; ok {
+				var res struct{ CODE, MESSAGE string }
+				if json.Unmarshal(v, &res) == nil {
+					code, msg = res.CODE, res.MESSAGE
+				}
+			}
+		}
+	}
+	return code, msg, total
+}
+
+func (c *Client) getPage(ctx context.Context, month string, page int) (*apiResp, error) {
+	q := url.Values{}
+	q.Set("KEY", c.Key)
+	q.Set("Type", "json")
+	q.Set("STATBL_ID", StatblID)
+	q.Set("DTACYCLE_CD", "MM")
+	q.Set("WRTTIME_IDTFR_ID", month)
+	q.Set("pIndex", strconv.Itoa(page))
+	q.Set("pSize", strconv.Itoa(pageSize))
+	base := c.Base
+	if base == "" {
+		base = baseURL
+	}
+	u := base + "?" + q.Encode()
+	var lastErr error
+	for attempt := 0; attempt < 3; attempt++ {
+		if attempt > 0 {
+			w := c.RetryWait
+			if w == 0 {
+				w = 2 * time.Second
+			}
+			time.Sleep(time.Duration(attempt*attempt) * w)
+		}
+		if c.Pause > 0 && c.Calls > 0 {
+			time.Sleep(c.Pause)
+		}
+		c.Calls++
+		body, status, err := c.get(ctx, u)
+		if err != nil || status >= 500 {
+			if err == nil {
+				err = fmt.Errorf("http %d", status)
+			}
+			lastErr = err
+			continue
+		}
+		if status != http.StatusOK {
+			return nil, &APIError{Msg: fmt.Sprintf("http %d: %s", status, c.redact(snippet(body)))}
+		}
+		var r apiResp
+		if err := json.Unmarshal(body, &r); err != nil {
+			return nil, &APIError{Msg: "not json: " + c.redact(snippet(body))}
+		}
+		return &r, nil
+	}
+	return nil, fmt.Errorf("%s page %d: %s", month, page, c.redact(lastErr.Error()))
+}
+
+func (c *Client) get(ctx context.Context, u string) ([]byte, int, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, u, nil)
+	if err != nil {
+		return nil, 0, err
+	}
+	hc := c.HTTP
+	if hc == nil {
+		hc = &http.Client{Timeout: 60 * time.Second}
+	}
+	res, err := hc.Do(req)
+	if err != nil {
+		var ue *url.Error
+		if errors.As(err, &ue) {
+			return nil, 0, fmt.Errorf("request failed: %v", ue.Err) // 요청 주소(키 포함)를 남기지 않는다
+		}
+		return nil, 0, errors.New("request failed")
+	}
+	defer res.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(res.Body, 32<<20))
+	return body, res.StatusCode, err
+}
+
+func (c *Client) redact(s string) string {
+	if c.Key == "" {
+		return s
+	}
+	return strings.ReplaceAll(strings.ReplaceAll(s, c.Key, "***"), url.QueryEscape(c.Key), "***")
+}
+
+func snippet(b []byte) string {
+	s := strings.TrimSpace(string(b))
+	if len(s) > 300 {
+		s = s[:300]
+	}
+	return s
+}
diff --git a/internal/etl/rone/rone_test.go b/internal/etl/rone/rone_test.go
new file mode 100644
index 0000000..6b3f523
--- /dev/null
+++ b/internal/etl/rone/rone_test.go
@@ -0,0 +1,114 @@
+package rone
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+// 정상 응답 모양(2026-10-28 운영 서버 프로브): head에 건수와 RESULT, 다음 원소에 row.
+const okPage = `{"SttsApiTblData":[{"head":[{"list_total_count":%d},{"RESULT":{"CODE":"INFO-000","MESSAGE":"정상 처리되었습니다."}}]},{"row":[%s]}]}`
+const rowTmpl = `{"WRTTIME_IDTFR_ID":"%s","GRP_FULLNM":%s,"CLS_FULLNM":"%s","ITM_FULLNM":"지가변동률","DTA_VAL":%s}`
+const noDataPage = `{"RESULT":{"CODE":"INFO-200","MESSAGE":"해당하는 데이터가 없습니다."}}`
+
+func TestFetchMonthPagesUntilTotal(t *testing.T) {
+	// 3건을 1건씩 3페이지로 준다. 값이 빈 행(null)도 건수에는 들어가므로 끝까지 넘겨야 한다.
+	var calls int
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		q := r.URL.Query()
+		if q.Get("KEY") != "SECRET" || q.Get("STATBL_ID") != StatblID || q.Get("DTACYCLE_CD") != "MM" || q.Get("WRTTIME_IDTFR_ID") != "202606" || q.Get("Type") != "json" {
+			t.Errorf("bad query: %v", q)
+		}
+		var row string
+		switch q.Get("pIndex") {
+		case "1":
+			row = fmt.Sprintf(rowTmpl, "202606", `"부산>중구"`, "주거지역", "0.016")
+		case "2":
+			row = fmt.Sprintf(rowTmpl, "202606", `"부산>중구"`, "상업지역", "null")
+		case "3":
+			row = fmt.Sprintf(rowTmpl, "202606", "null", "주거지역", "-0.1")
+		}
+		fmt.Fprintf(w, okPage, 3, row)
+	}))
+	defer srv.Close()
+	c := &Client{Key: "SECRET", Base: srv.URL}
+	rows, ok, err := c.FetchMonth(context.Background(), "202606")
+	if err != nil || !ok {
+		t.Fatalf("ok=%v err=%v", ok, err)
+	}
+	if calls != 3 || len(rows) != 2 {
+		t.Fatalf("calls=%d rows=%d, want 3/2", calls, len(rows))
+	}
+	if rows[0].Region != "부산>중구" || rows[0].Zone != "주거지역" || rows[0].Rate != 0.016 || rows[0].Month != "202606" {
+		t.Fatalf("row0 %+v", rows[0])
+	}
+	if rows[1].Region != "" || rows[1].Rate != -0.1 {
+		t.Fatalf("row1 (전국 집계) %+v", rows[1])
+	}
+}
+
+func TestFetchMonthNoDataAndAPIError(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Query().Get("WRTTIME_IDTFR_ID") == "209912" {
+			fmt.Fprint(w, noDataPage)
+			return
+		}
+		// 키 오류. 원문에 키가 섞여도 오류 메시지엔 남지 않아야 한다.
+		fmt.Fprint(w, `{"RESULT":{"CODE":"ERROR-290","MESSAGE":"인증키 SECRET 가 유효하지 않습니다."}}`)
+	}))
+	defer srv.Close()
+	c := &Client{Key: "SECRET", Base: srv.URL}
+	rows, ok, err := c.FetchMonth(context.Background(), "209912")
+	if err != nil || ok || rows != nil {
+		t.Fatalf("no data: rows=%v ok=%v err=%v", rows, ok, err)
+	}
+	_, _, err = c.FetchMonth(context.Background(), "202606")
+	var ae *APIError
+	if !errors.As(err, &ae) || !strings.Contains(err.Error(), "ERROR-290") {
+		t.Fatalf("want APIError ERROR-290, got %v", err)
+	}
+	if strings.Contains(err.Error(), "SECRET") {
+		t.Fatalf("key leaked: %v", err)
+	}
+}
+
+func TestFetchMonthUnknownShapeStops(t *testing.T) {
+	// 결과 코드가 아예 없는 응답(HTML 오류 페이지 등을 JSON으로 착각한 경우)을 빈 달로 넘기면 안 된다.
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		fmt.Fprint(w, `{"something":"else"}`)
+	}))
+	defer srv.Close()
+	c := &Client{Key: "k", Base: srv.URL}
+	_, ok, err := c.FetchMonth(context.Background(), "202606")
+	var ae *APIError
+	if ok || !errors.As(err, &ae) {
+		t.Fatalf("want APIError, got ok=%v err=%v", ok, err)
+	}
+}
+
+func TestServerErrorRetriesThenFailsWithoutKey(t *testing.T) {
+	var calls int
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		w.WriteHeader(http.StatusBadGateway)
+	}))
+	defer srv.Close()
+	c := &Client{Key: "SECRET", Base: srv.URL, RetryWait: time.Millisecond}
+	_, _, err := c.FetchMonth(context.Background(), "202606")
+	if err == nil || calls != 3 {
+		t.Fatalf("want 3 attempts and error, got calls=%d err=%v", calls, err)
+	}
+	var ae *APIError
+	if errors.As(err, &ae) {
+		t.Fatalf("5xx should be retryable error, not APIError: %v", err)
+	}
+	if strings.Contains(err.Error(), "SECRET") {
+		t.Fatalf("key leaked: %v", err)
+	}
+}
diff --git a/internal/etl/rone/sync.go b/internal/etl/rone/sync.go
new file mode 100644
index 0000000..b4abbe2
--- /dev/null
+++ b/internal/etl/rone/sync.go
@@ -0,0 +1,294 @@
+package rone
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/JO-HEEJIN/b2d_geo/internal/etl/priceindex"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+// Source는 이 적재기가 남기는 land_price_index.source 값이다(포털 파일 적재는 'reb_rone').
+const Source = "reb_rone_api"
+
+// Options는 한 번 실행의 범위다.
+type Options struct {
+	From, To string // YYYYMM, 양끝 포함
+	Refetch  int    // 이미 받은 달 중 마지막 N개월은 다시 받는다(공표 후 수정 대비)
+	Compare  bool   // 쓰지 않고 DB와 대조만(검증용). 범위 안의 모든 달을 받는다
+	Log      io.Writer
+}
+
+// Stats는 실행 결과다.
+type Stats struct {
+	Months     int      // 받은 달
+	NoData     []string // 아직 공표 전이라 비어 있던 달
+	Rows       int      // API 행
+	Records    int      // 적재(또는 대조)한 (시군구, 용도지역, 월)
+	Aggregate  int      // 집계 행이라 건너뜀
+	Unmapped   int      // 주소 DB에서 시군구를 못 찾아 건너뜀
+	Superseded int      // 같은 시군구에 현재 이름 행이 있어 버린 "(구)" 행
+	Dup        int      // 같은 시군구로 겹친 행(첫 행만 둠)
+	Unknown    []string // 미매핑 지역 이름(중복 없이)
+	Calls      int
+	Cmp        CompareStats
+}
+
+// CompareStats는 --compare 결과다.
+type CompareStats struct {
+	APIRecords, InDB, Same, Diff, OnlyDB int
+	Examples                             []string
+}
+
+type rec struct {
+	code, zone, month string
+	rate              float64
+	legacy            bool
+}
+
+// Run은 범위 안의 달을 받아 적재(또는 대조)한다. 받은 달은 DB에 남으므로 중간에 멈춰도 다음 실행이 이어 받는다.
+func Run(ctx context.Context, pool *pgxpool.Pool, c *Client, o Options) (*Stats, error) {
+	st := &Stats{}
+	months, err := monthRange(o.From, o.To)
+	if err != nil {
+		return st, err
+	}
+	logf := func(f string, a ...any) {
+		if o.Log != nil {
+			fmt.Fprintf(o.Log, f+"\n", a...)
+		}
+	}
+	xw, err := priceindex.Crosswalk(ctx, pool)
+	if err != nil {
+		return st, fmt.Errorf("crosswalk: %w", err)
+	}
+	todo := months
+	if !o.Compare {
+		if todo, err = pending(ctx, pool, months, o.Refetch); err != nil {
+			return st, err
+		}
+	}
+	logf("rone-sync: %s..%s months=%d todo=%d", o.From, o.To, len(months), len(todo))
+	unknown := map[string]bool{}
+	defer func() {
+		st.Calls = c.Calls
+		for n := range unknown {
+			st.Unknown = append(st.Unknown, n)
+		}
+		sort.Strings(st.Unknown)
+	}()
+	for _, m := range todo {
+		if err := ctx.Err(); err != nil {
+			return st, err
+		}
+		rows, ok, err := c.FetchMonth(ctx, m)
+		if err != nil {
+			return st, err
+		}
+		if !ok {
+			st.NoData = append(st.NoData, m)
+			continue
+		}
+		recs := build(rows, xw, st, unknown)
+		st.Months++
+		st.Rows += len(rows)
+		st.Records += len(recs)
+		if o.Compare {
+			if err := compare(ctx, pool, m, recs, &st.Cmp); err != nil {
+				return st, err
+			}
+		} else if err := upsert(ctx, pool, recs); err != nil {
+			return st, fmt.Errorf("%s: %w", m, err)
+		}
+		logf("rone-sync: %s rows=%d records=%d", m, len(rows), len(recs))
+	}
+	return st, nil
+}
+
+// pending은 받을 달이다: 아직 이 적재기로 받지 않은 달 + 받은 달 중 마지막 refetch개월.
+func pending(ctx context.Context, pool *pgxpool.Pool, months []string, refetch int) ([]string, error) {
+	rows, err := pool.Query(ctx, `SELECT DISTINCT month FROM land_price_index WHERE source=$1 AND month BETWEEN $2 AND $3 ORDER BY month`,
+		Source, months[0], months[len(months)-1])
+	if err != nil {
+		return nil, err
+	}
+	var loaded []string
+	for rows.Next() {
+		var m string
+		if err := rows.Scan(&m); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		loaded = append(loaded, m)
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return pick(months, loaded, refetch), nil
+}
+
+// pick은 pending의 순수 계산 부분이다.
+func pick(months, loaded []string, refetch int) []string {
+	skip := map[string]bool{}
+	for i, m := range loaded {
+		if i < len(loaded)-refetch {
+			skip[m] = true
+		}
+	}
+	var out []string
+	for _, m := range months {
+		if !skip[m] {
+			out = append(out, m)
+		}
+	}
+	return out
+}
+
+// build는 API 행을 (시군구, 용도지역, 월) 레코드로 바꾼다. 같은 키가 겹치면 현재 이름 행이 "(구)" 행을 이기고,
+// 그 밖의 겹침은 첫 행만 둔다(한 번의 INSERT ... ON CONFLICT에 같은 키가 두 번 들어가면 실패한다).
+func build(rows []Row, xw map[string]string, st *Stats, unknown map[string]bool) []rec {
+	// 하위 지역이 있는 경로("경기>수원시")는 시 전체 집계다. 주소 DB에서 못 찾아도 미매핑으로 세지 않는다.
+	parents := map[string]bool{}
+	for _, r := range rows {
+		parts := strings.Split(r.Region, ">")
+		for i := 1; i < len(parts); i++ {
+			parents[strings.Join(parts[:i], ">")] = true
+		}
+	}
+	var out []rec
+	at := map[string]int{}
+	for _, r := range rows {
+		p := parseRegion(r.Region)
+		if p.Aggregate || r.Zone == "" {
+			st.Aggregate++
+			continue
+		}
+		code := p.Code
+		if code == "" {
+			code = xw[p.Name]
+		}
+		if code == "" {
+			if parents[r.Region] {
+				st.Aggregate++
+			} else {
+				st.Unmapped++
+				unknown[r.Region] = true
+			}
+			continue
+		}
+		x := rec{code: code, zone: r.Zone, month: r.Month, rate: r.Rate, legacy: p.Legacy}
+		k := code + "|" + r.Zone + "|" + r.Month
+		i, seen := at[k]
+		switch {
+		case !seen:
+			at[k] = len(out)
+			out = append(out, x)
+		case out[i].legacy && !x.legacy:
+			out[i] = x
+			st.Superseded++
+		case x.legacy && !out[i].legacy:
+			st.Superseded++
+		default:
+			st.Dup++
+		}
+	}
+	return out
+}
+
+func upsert(ctx context.Context, pool *pgxpool.Pool, recs []rec) error {
+	if len(recs) == 0 {
+		return nil
+	}
+	codes := make([]string, len(recs))
+	zones := make([]string, len(recs))
+	months := make([]string, len(recs))
+	rates := make([]string, len(recs))
+	for i, r := range recs {
+		codes[i], zones[i], months[i] = r.code, r.zone, r.month
+		rates[i] = strconv.FormatFloat(r.rate, 'f', -1, 64) // 원값 그대로(numeric으로 넣어 부동소수 꼬리를 만들지 않는다)
+	}
+	_, err := pool.Exec(ctx, `
+		INSERT INTO land_price_index (sigungu_code, use_zone_class, month, rate_pct, source, source_version)
+		SELECT c, z, m, r::numeric, $5, now()::date
+		FROM unnest($1::text[], $2::text[], $3::text[], $4::text[]) AS t(c, z, m, r)
+		ON CONFLICT (sigungu_code, use_zone_class, month)
+		DO UPDATE SET rate_pct=EXCLUDED.rate_pct, source=EXCLUDED.source, source_version=EXCLUDED.source_version`,
+		codes, zones, months, rates, Source)
+	return err
+}
+
+// compare는 한 달치를 DB와 대조만 한다. 값 차이·API에만 있음·DB에만 있음을 센다.
+func compare(ctx context.Context, pool *pgxpool.Pool, month string, recs []rec, cs *CompareStats) error {
+	rows, err := pool.Query(ctx, `SELECT sigungu_code, use_zone_class, rate_pct::float8 FROM land_price_index WHERE month=$1`, month)
+	if err != nil {
+		return err
+	}
+	db := map[string]float64{}
+	for rows.Next() {
+		var c, z string
+		var v float64
+		if err := rows.Scan(&c, &z, &v); err != nil {
+			rows.Close()
+			return err
+		}
+		db[c+"|"+z] = v
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		return err
+	}
+	example := func(s string) {
+		if len(cs.Examples) < 20 {
+			cs.Examples = append(cs.Examples, s)
+		}
+	}
+	onlyDBShown := 0
+	seen := map[string]bool{}
+	for _, r := range recs {
+		cs.APIRecords++
+		k := r.code + "|" + r.zone
+		seen[k] = true
+		v, ok := db[k]
+		if !ok {
+			continue
+		}
+		cs.InDB++
+		if math.Abs(v-r.rate) < 1e-9 {
+			cs.Same++
+		} else {
+			cs.Diff++
+			example(fmt.Sprintf("diff %s %s %s db=%v api=%v", month, r.code, r.zone, v, r.rate))
+		}
+	}
+	for k := range db {
+		if !seen[k] {
+			cs.OnlyDB++
+			if onlyDBShown < 3 { // 값 차이 예시가 묻히지 않게 달마다 3개까지만
+				onlyDBShown++
+				example(fmt.Sprintf("only-db %s %s", month, strings.Replace(k, "|", " ", 1)))
+			}
+		}
+	}
+	return nil
+}
+
+// monthRange는 from..to(YYYYMM, 양끝 포함)의 달 목록이다.
+func monthRange(from, to string) ([]string, error) {
+	f, err1 := time.Parse("200601", from)
+	t, err2 := time.Parse("200601", to)
+	if err1 != nil || err2 != nil || t.Before(f) {
+		return nil, fmt.Errorf("month range must be YYYYMM and from <= to: %q..%q", from, to)
+	}
+	var out []string
+	for m := f; !m.After(t); m = m.AddDate(0, 1, 0) {
+		out = append(out, m.Format("200601"))
+	}
+	return out, nil
+}
