index 0000000..5785c8d
--- /dev/null
+++ b/internal/etl/ned/schedule.go
@@ -0,0 +1,36 @@
+package ned
+
+import (
+	"fmt"
+	"time"
+)
+
+// KST는 일정 계산 기준 시간대다. distroless 이미지엔 tzdata가 없어 고정 오프셋을 쓴다(서머타임 없음).
+var KST = time.FixedZone("KST", 9*60*60)
+
+// AutoYear는 받을 기준연도다. 개별공시지가는 매년 5월 말 공시되므로 6월부터는 올해, 그 전에는 작년.
+func AutoYear(now time.Time) int {
+	k := now.In(KST)
+	if k.Month() < time.June {
+		return k.Year() - 1
+	}
+	return k.Year()
+}
+
+// ParseClock는 "03:17" 같은 KST 시각을 시·분으로 바꾼다.
+func ParseClock(s string) (hh, mm int, err error) {
+	if _, err = fmt.Sscanf(s, "%d:%d", &hh, &mm); err != nil || hh < 0 || hh > 23 || mm < 0 || mm > 59 {
+		return 0, 0, fmt.Errorf("time must be HH:MM (KST): %q", s)
+	}
+	return hh, mm, nil
+}
+
+// NextRun은 now 이후 처음 오는 KST hh:mm이다. 지금이 정확히 그 시각이면 다음 날로 넘긴다.
+func NextRun(now time.Time, hh, mm int) time.Time {
+	k := now.In(KST)
+	t := time.Date(k.Year(), k.Month(), k.Day(), hh, mm, 0, 0, KST)
+	if !t.After(k) {
+		t = t.AddDate(0, 0, 1)
+	}
+	return t
+}
diff --git a/internal/etl/ned/schedule_test.go b/internal/etl/ned/schedule_test.go
new file mode 100644
index 0000000..1432b33
--- /dev/null
+++ b/internal/etl/ned/schedule_test.go
@@ -0,0 +1,49 @@
+package ned
+
+import (
+	"testing"
+	"time"
+)
+
+func TestAutoYear(t *testing.T) {
+	cases := map[string]int{
+		"2026-05-31T23:59:00+09:00": 2025, // 5월까지는 작년
+		"2026-06-01T00:00:00+09:00": 2026, // 6월부터 올해
+		"2026-05-31T15:30:00Z":      2026, // UTC 5/31 15:30 = KST 6/1 00:30
+		"2027-01-15T10:00:00+09:00": 2026,
+	}
+	for in, want := range cases {
+		now, _ := time.Parse(time.RFC3339, in)
+		if got := AutoYear(now); got != want {
+			t.Errorf("AutoYear(%s) = %d, want %d", in, got, want)
+		}
+	}
+}
+
+func TestNextRun(t *testing.T) {
+	cases := []struct{ now, want string }{
+		{"2026-10-28T02:00:00+09:00", "2026-10-28T03:17:00+09:00"}, // 오늘 03:17 전
+		{"2026-10-28T03:17:00+09:00", "2026-10-29T03:17:00+09:00"}, // 정각이면 다음 날
+		{"2026-10-28T12:00:00+09:00", "2026-10-29T03:17:00+09:00"},
+		{"2026-12-31T20:00:00Z", "2027-01-02T03:17:00+09:00"}, // UTC 12/31 20:00 = KST 1/1 05:00
+		{"2026-10-27T18:00:00Z", "2026-10-28T03:17:00+09:00"}, // UTC 18:00 = KST 03:00
+	}
+	for _, c := range cases {
+		now, _ := time.Parse(time.RFC3339, c.now)
+		want, _ := time.Parse(time.RFC3339, c.want)
+		if got := NextRun(now, 3, 17); !got.Equal(want) {
+			t.Errorf("NextRun(%s) = %s, want %s", c.now, got, want)
+		}
+	}
+}
+
+func TestParseClock(t *testing.T) {
+	if h, m, err := ParseClock("03:17"); err != nil || h != 3 || m != 17 {
+		t.Fatalf("03:17 -> %d %d %v", h, m, err)
+	}
+	for _, bad := range []string{"", "24:00", "3", "03:60", "ab:cd"} {
+		if _, _, err := ParseClock(bad); err == nil {
+			t.Errorf("%q should fail", bad)
+		}
+	}
+}
diff --git a/internal/etl/ned/sync.go b/internal/etl/ned/sync.go
new file mode 100644
index 0000000..0b3a7c4
--- /dev/null
+++ b/internal/etl/ned/sync.go
@@ -0,0 +1,245 @@
+package ned
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"time"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+// Options는 한 번 실행의 범위다.
+type Options struct {
+	Datasets []Dataset
+	Year     int
+	Sido     []string  // 시도 2자리 코드. 비면 전국
+	MaxCalls int       // 이만큼 호출하면 멈춘다(일일 한도 보호). 0이면 제한 없음
+	Compare  bool      // true면 적재하지 않고 DB와 대조만 한다(검증용, 진행 기록도 안 남김)
+	MaxDongs int       // 0이면 제한 없음. 검증·시범용
+	Log      io.Writer // 진행 로그
+}
+
+// Stats는 실행 결과 요약이다.
+type Stats struct {
+	Dongs, Rows, Calls int
+	Stopped            string // 멈춘 이유(한도·API 오류). 끝까지 갔으면 빈 문자열
+	Cmp                CompareStats
+}
+
+// CompareStats는 Compare 모드에서 API 값과 DB 값을 필지별로 맞춰 본 결과다.
+type CompareStats struct {
+	APIRows, InDB, Same, Diff int
+	Examples                  []string
+}
+
+// Run은 법정동 목록을 돌며 받고 적재한다. 끝낸 동은 진행 기록에 남겨 다음 실행에서 건너뛴다.
+func Run(ctx context.Context, pool *pgxpool.Pool, c *Client, o Options) (Stats, error) {
+	var st Stats
+	for _, d := range o.Datasets {
+		dongs, err := pendingDongs(ctx, pool, d, o)
+		if err != nil {
+			return st, err
+		}
+		fmt.Fprintf(o.Log, "ned-sync %s %d: %d dongs to do\n", d, o.Year, len(dongs))
+		for i, bcode := range dongs {
+			if o.MaxCalls > 0 && c.Calls >= o.MaxCalls {
+				st.Stopped = fmt.Sprintf("max-calls %d reached", o.MaxCalls)
+				st.Calls = c.Calls
+				return st, nil
+			}
+			rows, total, err := c.FetchDong(ctx, d, bcode, o.Year)
+			if err != nil {
+				var ae *APIError
+				if errors.As(err, &ae) {
+					st.Stopped = ae.Error() // 키·권한·한도 문제는 다음 날 이어서
+					st.Calls = c.Calls
+					return st, nil
+				}
+				return st, fmt.Errorf("%s %s: %w", d, bcode, err)
+			}
+			if o.Compare {
+				if err := compare(ctx, pool, d, rows, &st.Cmp); err != nil {
+					return st, err
+				}
+			} else {
+				if err := upsert(ctx, pool, d, rows); err != nil {
+					return st, fmt.Errorf("%s %s upsert: %w", d, bcode, err)
+				}
+				if _, err := pool.Exec(ctx, `
+					INSERT INTO ned_sync_progress (dataset, base_year, bcode, rows) VALUES ($1,$2,$3,$4)
+					ON CONFLICT (dataset, base_year, bcode) DO UPDATE SET rows = EXCLUDED.rows, synced_at = now()`,
+					string(d), o.Year, bcode, len(rows)); err != nil {
+					return st, err
+				}
+			}
+			st.Dongs++
+			st.Rows += len(rows)
+			if (i+1)%100 == 0 || i == len(dongs)-1 {
+				fmt.Fprintf(o.Log, "  %s %d/%d dongs, rows %d, calls %d (last %s total %d)\n",
+					d, i+1, len(dongs), st.Rows, c.Calls, bcode, total)
+			}
+		}
+	}
+	st.Calls = c.Calls
+	return st, nil
+}
+
+// pendingDongs는 필지가 실제로 있는 법정동 중 이번 연도에 아직 안 끝낸 동을 돌려준다.
+// parcels(bcode, jibun) 인덱스의 범위 조건으로 시도별로 뽑는다.
+func pendingDongs(ctx context.Context, pool *pgxpool.Pool, d Dataset, o Options) ([]string, error) {
+	sidos := o.Sido
+	if len(sidos) == 0 {
+		sidos = []string{""}
+	}
+	var out []string
+	for _, sd := range sidos {
+		lo := (sd + "0000000000")[:10]
+		hi := (sd + "9999999999")[:10]
+		q := `SELECT DISTINCT p.bcode FROM parcels p
+		      WHERE p.bcode >= $1 AND p.bcode <= $2`
+		args := []any{lo, hi}
+		if !o.Compare {
+			q += ` AND NOT EXISTS (SELECT 1 FROM ned_sync_progress s
+			        WHERE s.dataset = $3 AND s.base_year = $4 AND s.bcode = p.bcode)`
+			args = append(args, string(d), o.Year)
+		}
+		q += ` ORDER BY 1`
+		rows, err := pool.Query(ctx, q, args...)
+		if err != nil {
+			return nil, err
+		}
+		for rows.Next() {
+			var b string
+			if err := rows.Scan(&b); err != nil {
+				rows.Close()
+				return nil, err
+			}
+			out = append(out, b)
+			if o.MaxDongs > 0 && len(out) >= o.MaxDongs {
+				break
+			}
+		}
+		rows.Close()
+		if err := rows.Err(); err != nil {
+			return nil, err
+		}
+		if o.MaxDongs > 0 && len(out) >= o.MaxDongs {
+			break
+		}
+	}
+	return out, nil
+}
+
+// upsert는 한 동의 행을 한 문장으로 넣는다. 같은 (pnu, 연도)가 두 번 오면 뒤의 것을 쓴다.
+func upsert(ctx context.Context, pool *pgxpool.Pool, d Dataset, rows []Row) error {
+	rows = dedupe(rows)
+	if len(rows) == 0 {
+		return nil
+	}
+	pnus := make([]string, len(rows))
+	years := make([]int16, len(rows))
+	vers := make([]time.Time, len(rows))
+	for i, r := range rows {
+		pnus[i], years[i], vers[i] = r.PNU, int16(r.BaseYear), r.SourceVersion
+	}
+	switch d {
+	case Price:
+		prices := make([]int64, len(rows))
+		for i, r := range rows {
+			prices[i] = r.PricePerSqm
+		}
+		_, err := pool.Exec(ctx, `
+			INSERT INTO official_land_prices (pnu, base_year, price_per_sqm, source, source_version)
+			SELECT u.pnu, u.y, u.p, 'vworld_ned', u.v
+			  FROM unnest($1::char(19)[], $2::smallint[], $3::bigint[], $4::date[]) AS u(pnu, y, p, v)
+			ON CONFLICT (pnu, base_year) DO UPDATE
+			   SET price_per_sqm = EXCLUDED.price_per_sqm, source = EXCLUDED.source,
+			       source_version = EXCLUDED.source_version`,
+			pnus, years, prices, vers)
+		return err
+	case Features:
+		lu := make([]string, len(rows))
+		th := make([]string, len(rows))
+		ts := make([]string, len(rows))
+		rs := make([]string, len(rows))
+		for i, r := range rows {
+			lu[i], th[i], ts[i], rs[i] = r.LandUse, r.TerrainHeight, r.TerrainShape, r.RoadSide
+		}
+		_, err := pool.Exec(ctx, `
+			INSERT INTO land_features (pnu, base_year, land_use, terrain_height, terrain_shape, road_side, source, source_version)
+			SELECT u.pnu, u.y, u.lu, u.th, u.ts, u.rs, 'vworld_ned', u.v
+			  FROM unnest($1::char(19)[], $2::smallint[], $3::text[], $4::text[], $5::text[], $6::text[], $7::date[])
+			       AS u(pnu, y, lu, th, ts, rs, v)
+			ON CONFLICT (pnu, base_year) DO UPDATE
+			   SET land_use = EXCLUDED.land_use, terrain_height = EXCLUDED.terrain_height,
+			       terrain_shape = EXCLUDED.terrain_shape, road_side = EXCLUDED.road_side,
+			       source = EXCLUDED.source, source_version = EXCLUDED.source_version`,
+			pnus, years, lu, th, ts, rs, vers)
+		return err
+	}
+	return fmt.Errorf("unknown dataset %q", d)
+}
+
+func dedupe(rows []Row) []Row {
+	idx := make(map[string]int, len(rows))
+	out := rows[:0:0]
+	for _, r := range rows {
+		k := r.PNU + fmt.Sprint(r.BaseYear)
+		if i, ok := idx[k]; ok {
+			out[i] = r
+			continue
+		}
+		idx[k] = len(out)
+		out = append(out, r)
+	}
+	return out
+}
+
+// compare는 API 행과 DB에 이미 있는 행(파일 적재분)을 필지별로 대조한다. 쓰지 않는다.
+func compare(ctx context.Context, pool *pgxpool.Pool, d Dataset, rows []Row, cs *CompareStats) error {
+	rows = dedupe(rows)
+	cs.APIRows += len(rows)
+	for _, r := range rows {
+		var same bool
+		var dbv string
+		var err error
+		switch d {
+		case Price:
+			var v int64
+			err = pool.QueryRow(ctx, `SELECT price_per_sqm FROM official_land_prices WHERE pnu=$1 AND base_year=$2`,
+				r.PNU, r.BaseYear).Scan(&v)
+			same, dbv = v == r.PricePerSqm, fmt.Sprint(v)
+		case Features:
+			var lu, th, ts, rs *string
+			err = pool.QueryRow(ctx, `SELECT land_use, terrain_height, terrain_shape, road_side FROM land_features WHERE pnu=$1 AND base_year=$2`,
+				r.PNU, r.BaseYear).Scan(&lu, &th, &ts, &rs)
+			s := func(p *string) string {
+				if p == nil {
+					return ""
+				}
+				return *p
+			}
+			same = s(lu) == r.LandUse && s(th) == r.TerrainHeight && s(ts) == r.TerrainShape && s(rs) == r.RoadSide
+			dbv = fmt.Sprintf("%s|%s|%s|%s", s(lu), s(th), s(ts), s(rs))
+		}
+		if err != nil {
+			continue // DB에 없는 필지(파일엔 없고 API엔 있는 경우)는 InDB에 세지 않는다
+		}
+		cs.InDB++
+		if same {
+			cs.Same++
+			continue
+		}
+		cs.Diff++
+		if len(cs.Examples) < 8 {
+			api := fmt.Sprint(r.PricePerSqm)
+			if d == Features {
+				api = fmt.Sprintf("%s|%s|%s|%s", r.LandUse, r.TerrainHeight, r.TerrainShape, r.RoadSide)
+			}
+			cs.Examples = append(cs.Examples, fmt.Sprintf("%s %s %d: db=%s api=%s", d, r.PNU, r.BaseYear, dbv, api))
+		}
+	}
+	return nil
+}
diff --git a/internal/etl/ned/sync_pg_test.go b/internal/etl/ned/sync_pg_test.go
new file mode 100644
index 0000000..e71c877
--- /dev/null
+++ b/internal/etl/ned/sync_pg_test.go
@@ -0,0 +1,100 @@
+package ned
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+// TestRunAgainstPostgres는 실제 PostGIS(마이그레이션 적용된 빈 DB)에서 적재·이어받기·대조·호출 한도를 본다.
+// B2D_TEST_DATABASE_URL이 없으면 건너뛴다(운영 DB에 절대 쓰지 말 것: 아래에서 테이블을 비운다).
+func TestRunAgainstPostgres(t *testing.T) {
+	dsn := os.Getenv("B2D_TEST_DATABASE_URL")
+	if dsn == "" {
+		t.Skip("B2D_TEST_DATABASE_URL not set")
+	}
+	ctx := context.Background()
+	pool, err := pgxpool.New(ctx, dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pool.Close()
+	for _, q := range []string{
+		`TRUNCATE parcels, official_land_prices, land_features, ned_sync_progress`,
+		// 세종(36) 두 동과 다른 시도(11) 한 동
+		`INSERT INTO parcels (pnu, bcode, jibun, source, source_version) VALUES
+		   ('3611010100100010000','3611010100','1','t','2026-01-01'),
+		   ('3611010100100020000','3611010100','2','t','2026-01-01'),
+		   ('3611010200100010000','3611010200','1','t','2026-01-01'),
+		   ('1111010100100010000','1111010100','1','t','2026-01-01')`,
+	} {
+		if _, err := pool.Exec(ctx, q); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var calls int
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		b := r.URL.Query().Get("pnu")
+		if strings.HasSuffix(r.URL.Path, "getLandCharacteristics") {
+			fmt.Fprintf(w, `{"landCharacteristicss":{"field":[{"pnu":"%s100010000","stdrYear":"2026","lastUpdtDt":"2026-05-12","ladUseSittnNm":"주거용","tpgrphHgCodeNm":"평지","tpgrphFrmCodeNm":"정방형","roadSideCodeNm":"세로한면(가)"}],"totalCount":"1","resultCode":""}}`, b)
+			return
+		}
+		fmt.Fprintf(w, `{"indvdLandPrices":{"field":[{"pnu":"%s100010000","stdrYear":"2026","lastUpdtDt":"2026-05-21","pblntfPclnd":"500000"},{"pnu":"%s100020000","stdrYear":"2026","lastUpdtDt":"2026-05-21","pblntfPclnd":"600000"}],"totalCount":"2","resultCode":""}}`, b, b)
+	}))
+	defer srv.Close()
+	newClient := func() *Client { return &Client{Key: "k", Domain: "d", Base: srv.URL + "/"} }
+	var log bytes.Buffer
+	o := Options{Datasets: []Dataset{Price, Features}, Year: 2026, Sido: []string{"36"}, Log: &log}
+
+	// 1) 호출 한도: 1회 호출 후 멈추고, 그 동만 기록된다.
+	lim := o
+	lim.MaxCalls = 1
+	st, err := Run(ctx, pool, newClient(), lim)
+	if err != nil || st.Stopped == "" || st.Dongs != 1 {
+		t.Fatalf("max-calls run: %+v err=%v", st, err)
+	}
+	// 2) 이어받기: 남은 것만 받는다(가격 1동 + 특성 2동 = 3호출).
+	calls = 0
+	st, err = Run(ctx, pool, newClient(), o)
+	if err != nil || st.Stopped != "" || calls != 3 {
+		t.Fatalf("resume run: %+v calls=%d err=%v log=%s", st, calls, err, log.String())
+	}
+	var nPrice, nFeat, nProg int
+	pool.QueryRow(ctx, `SELECT count(*) FROM official_land_prices WHERE base_year=2026 AND source='vworld_ned'`).Scan(&nPrice)
+	pool.QueryRow(ctx, `SELECT count(*) FROM land_features WHERE base_year=2026 AND road_side='세로한면(가)'`).Scan(&nFeat)
+	pool.QueryRow(ctx, `SELECT count(*) FROM ned_sync_progress`).Scan(&nProg)
+	if nPrice != 4 || nFeat != 2 || nProg != 4 {
+		t.Fatalf("rows price=%d feat=%d progress=%d, want 4/2/4", nPrice, nFeat, nProg)
+	}
+	var p int64
+	pool.QueryRow(ctx, `SELECT price_per_sqm FROM official_land_prices WHERE pnu='3611010200100020000' AND base_year=2026`).Scan(&p)
+	if p != 600000 {
+		t.Fatalf("price %d", p)
+	}
+	// 3) 다시 돌리면 할 일이 없다.
+	calls = 0
+	if st, err = Run(ctx, pool, newClient(), o); err != nil || calls != 0 || st.Dongs != 0 {
+		t.Fatalf("idempotent run: %+v calls=%d err=%v", st, calls, err)
+	}
+	// 4) 대조 모드: 쓰지 않고 같은 값이면 same으로 센다. 한 필지 값을 바꿔 diff 1을 만든다.
+	pool.Exec(ctx, `UPDATE official_land_prices SET price_per_sqm=1 WHERE pnu='3611010100100010000' AND base_year=2026`)
+	cmp := o
+	cmp.Compare = true
+	cmp.Datasets = []Dataset{Price}
+	st, err = Run(ctx, pool, newClient(), cmp)
+	if err != nil || st.Cmp.InDB != 4 || st.Cmp.Same != 3 || st.Cmp.Diff != 1 || len(st.Cmp.Examples) != 1 {
+		t.Fatalf("compare: %+v err=%v", st.Cmp, err)
+	}
+	pool.QueryRow(ctx, `SELECT price_per_sqm FROM official_land_prices WHERE pnu='3611010100100010000' AND base_year=2026`).Scan(&p)
+	if p != 1 {
+		t.Fatalf("compare mode must not write, price now %d", p)
+	}
+}
